# CODEVERSE backend configuration.
#
# Local development: copy to backend/.env and fill in.
# Production (Ubuntu): copy to /etc/codeverse/backend.env (root:root, chmod 600);
#   systemd loads it, so the app user cannot read the file. See README.md.
#
# Every value below is server-side only. Nothing here is ever sent to the browser.
# NEVER commit a filled-in copy of this file.

# ── Runtime ─────────────────────────────────────────────────────────────────
# "production" turns on strict startup checks (refuses to start if insecure).
ENVIRONMENT=development
LOG_LEVEL=INFO
# Serve interactive API docs at /api/docs (keep false in production).
ENABLE_DOCS=false

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-public-key>
# Service-role key: full database access. Backend only — never in the frontend.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
# Optional (recommended at scale): legacy JWT secret (Project Settings → API → JWT Settings).
# Lets the backend verify team sessions locally instead of calling Supabase on
# every request. Projects using the newer JWT signing keys need nothing here.
SUPABASE_JWT_SECRET=

# Postgres connection (Project Settings → Database → Connection string).
# For 300–400 players use the pooler ("Transaction" mode, port 6543):
#   postgresql+psycopg2://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres:<database-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Read-only role for the Phase 2 Stage 1 SQL console (created by supabase/schema.sql).
# Through the pooler the user name is forensic_reader.<project-ref>.
FORENSIC_DATABASE_URL=postgresql+psycopg2://forensic_reader:<forensic-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# SQLAlchemy pool per worker. Total ≈ workers × (DB_POOL_SIZE + DB_MAX_OVERFLOW).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ── Sessions & admin ────────────────────────────────────────────────────────
# Signs admin sessions. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<long-random-secret>
# true whenever the site is served over HTTPS (always in production).
COOKIE_SECURE=false
# Organizer login for the admin dashboards (both phases).
ADMIN_USERNAME=<organizer-username>
ADMIN_PASSWORD=<strong-organizer-password>

# Comma-separated origins allowed to call the API from another origin.
# Leave EMPTY for the normal deployment (frontend and /api on the same domain).
CORS_ORIGINS=

# ── Phase 2 event answers ───────────────────────────────────────────────────
# Seeded into config_kv on first startup; organizers can change them later in
# the admin dashboard. Use fresh values for every event.
STAGE1_DELETION_KEY=<stage-1-answer>
CTF_PUZZLE3_CODE=<stage-2-header-answer>
CTF_CONTROL_TOKEN=<stage-2-output>
STAGE4_SHUTDOWN_CODE=<stage-4-credential>
STAGE4_SEQUENCE=<comma-separated-sequence>

# ── Phase 1 code execution (Alarm System + Printing Press) ──────────────────
# bwrap = require bubblewrap isolation (production), auto = use if available,
# none = no isolation (local development only).
CODE_SANDBOX=auto
CODE_EXEC_MAX_CONCURRENT=2
CODE_EXEC_QUEUE_TIMEOUT=20
CODE_EXEC_MEMORY_MB=1536

# ── Gunicorn (production) ───────────────────────────────────────────────────
# GUNICORN_WORKERS=5
