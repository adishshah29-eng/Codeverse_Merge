# /etc/apparmor.d/bwrap
# Ubuntu 23.10+ restricts unprivileged user namespaces. bubblewrap needs them
# to sandbox Phase 1 code runs. This profile grants that to /usr/bin/bwrap
# only. Install ONLY if `sudo -u codeverse bwrap --unshare-all --ro-bind / / true`
# fails with "setting up uid map: Permission denied" (see README).
abi <abi/4.0>,
include <tunables/global>

profile bwrap /usr/bin/bwrap flags=(unconfined) {
  userns,

  include if exists <local/bwrap>
}
