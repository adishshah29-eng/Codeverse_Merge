# Copy this file to backend/.env and replace every placeholder.
# Never commit backend/.env or share its database password.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-project-anon-key>
SUPABASE_SERVICE_ROLE_KEY
# Required: this Supabase PostgreSQL database stores all game and forensic data.
# Apply ../supabase/schema.sql to this database before starting the backend.
DATABASE_URL=postgresql+psycopg2://postgres:<database-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Use a unique random value in production.
SECRET_KEY=<long-random-secret>
COOKIE_SECURE=true

# Existing organizer login; choose non-default credentials for deployment.
ADMIN_USERNAME=<organizer-username>
ADMIN_PASSWORD=<strong-organizer-password>

# Set event answers here; the backend seeds them into ConfigKV on first startup.
# Use unique values for each deployment and keep backend/.env private.
STAGE1_DELETION_KEY=<stage-1-answer>
CTF_PUZZLE3_CODE=<stage-2-header-answer>
CTF_CONTROL_TOKEN=<stage-2-output>
STAGE4_SHUTDOWN_CODE=<stage-4-credential>
STAGE4_SEQUENCE=<comma-separated-sequence>