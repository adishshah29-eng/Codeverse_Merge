# Frontend build-time configuration (Vite). Copy to frontend/.env if needed.
#
# Everything prefixed VITE_ is compiled INTO the public JavaScript bundle.
# Never put secrets here — no keys, tokens, no
# passwords, no answers. The browser only ever talks to our own /api.

# API base path. Leave as /api for the standard deployment where Nginx serves
# the frontend and proxies /api to FastAPI on the same domain.
VITE_API_BASE_URL=/api

# Dev server only: where `npm run dev` proxies /api and /vendor.
# VITE_DEV_BACKEND=http://127.0.0.1:8000
